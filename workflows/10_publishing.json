    {
      "parameters": {
        "jsCode": "// Normalize an error output into {job_id, category, message}. Secrets are redacted before anything is persisted.\nconst j = $input.first().json;\nconst jobId = $('Begin Publication').first().json.r.publication_id;\nconst raw = JSON.stringify(j.error ?? j).slice(0, 700);\nconst m = raw.match(/\\b([45]\\d\\d)\\b/); const code = m ? +m[1] : 0;\nlet cat = 'UNKNOWN';\nif (/UNSUPPORTED:/.test(raw)) cat = 'UNSUPPORTED';\nelse if (/VALIDATION:/.test(raw)) cat = 'VALIDATION';\nelse if (/RIGHTS:/.test(raw)) cat = 'RIGHTS';\nelse if (code === 401 || code === 403 || /unauthori|invalid_grant|token.*expired|OAuthException|\\(#190\\)|permission|credentials/i.test(raw)) cat = 'AUTH';\nelse if (code === 429 || /quota|rate.?limit|request limit|\\(#17\\)|\\(#4\\)|\\(#32\\)|\\(#613\\)|RESOURCE_EXHAUSTED/i.test(raw)) cat = 'RATE_LIMIT';\nelse if (code >= 500 || /ECONN|ETIMEDOUT|ENOTFOUND|EAI_AGAIN|socket hang|timed? ?out/i.test(raw)) cat = 'TRANSIENT';\nelse if (code >= 400) cat = 'VALIDATION';\nif (['YouTube Upload', 'IG Publish', 'FB Publish Reel'].includes($prevNode.name) && (cat === 'TRANSIENT' || cat === 'UNKNOWN')) cat = 'AMBIGUOUS';   // upload may have succeeded: never auto-retried\nconst msg = raw.replace(/(api[_-]?key|key|token|secret|authorization|bearer)[\"'=:\\s]+[A-Za-z0-9._\\-]{8,}/gi, '$1=[redacted]');\nreturn [{ json: { publication_id: jobId, category: cat, message: msg } }];"
      },

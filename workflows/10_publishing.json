    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::uuid AS publication_id, $2::text AS platform, cv.per_platform -> $2::text AS meta, cl.video_url, (ca_setting('openshorts_base_url','\"http://localhost:8000\"'))#>>'{}' AS os_base, (ca_setting('public_media_base_url','\"\"'))#>>'{}' AS public_base, (ca_setting('meta_graph_version','\"v21.0\"'))#>>'{}' AS graph_v, (ca_setting('adapter_verified_' || $2::text,'false'))#>>'{}' AS verified, pa.external_account_id, COALESCE(ch.rules->>'youtube_category_id','22') AS yt_category, COALESCE(NULLIF(ch.rules->>'youtube_privacy',''),(ca_setting('youtube_default_privacy','\"private\"'))#>>'{}') AS yt_privacy, COALESCE(ch.rules->>'youtube_region','IN') AS yt_region FROM content c JOIN content_versions cv ON cv.content_id = c.content_id AND cv.version = c.approved_version JOIN clips cl ON cl.clip_id = cv.clip_id JOIN channels ch ON ch.id = c.channel_id LEFT JOIN platform_accounts pa ON pa.channel_id = c.channel_id AND pa.platform = $2::text AND pa.enabled WHERE c.content_id = $3::uuid",
        "options": {
          "queryReplacement": "={{ [$json.r.publication_id, $json.r.platform, $json.r.content_id] }}"
        }
      },
      "id": "0c6ad584-a34d-5b20-b2c6-5bfb406bd20a",
      "name": "Load Payload",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1040,

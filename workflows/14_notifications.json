    {
      "parameters": {
        "jsCode": "// EXPLICIT SEND-APPROVAL GATE\n// A real outbound email requires fresh, explicit owner approval for the specific notification ID.\n// If approval is absent, null, empty, expired, or mismatched, delivery is strictly blocked.\nconst item = $input.first().json;\nconst approval = item.approval;\n\nlet isApproved = false;\nlet gateReason = 'no_approval_configured';\n\nif (approval && typeof approval === 'object' && approval !== null) {\n  const now = Date.now();\n  const expiresAt = approval.expires_at ? new Date(approval.expires_at).getTime() : 0;\n  \n  if (expiresAt && expiresAt < now) {\n    gateReason = 'approval_expired';\n  } else if (approval.used === true) {\n    gateReason = 'approval_already_used';\n  } else if (approval.approved_notification_id && String(approval.approved_notification_id) === String(item.id)) {\n    isApproved = true;\n    gateReason = 'approved_for_notification_id';\n  } else if (approval.approved_all === true) {\n    // Blanket approval is strictly rejected per Section 5 rules\n    isApproved = false;\n    gateReason = 'blanket_approval_forbidden';\n  } else {\n    gateReason = 'notification_id_mismatch';\n  }\n}\n\nreturn [{\n  json: {\n    ...item,\n    is_approved: isApproved,\n    gate_reason: gateReason\n  }\n}];"
      },
      "id": "7a35c24e-4e89-4a92-b43e-908bc21c7d31",
      "name": "Send Approval Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b3e94471-46da-52c6-947f-1d843818e874",
              "leftValue": "={{ $json.is_approved === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f512db49-7c85-5b4d-9014-a9018e692a34",
      "name": "Send Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE notifications SET status = 'skipped' WHERE id = $1::uuid; SELECT ca_audit('system', 'notification_gate', 'skip_unapproved', 'notification', $1::uuid, 'pending', 'skipped', jsonb_build_object('reason', $2::text, 'recipient', $3::text));",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.gate_reason, $json.email] }}"
        }
      },
      "id": "84c90e21-9988-4e12-b912-3298a0d9b456",
      "name": "Skip (unapproved send)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1300,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "cacred0000000001",
          "name": "CA Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const redact = s => String(s || '').replace(/(api[_-]?key|key|token|secret|authorization|bearer|password)[\"'=: ]+[A-Za-z0-9._\\-]{8,}/gi, '$1=[redacted]');\nreturn $input.all().map(i => ({ json: { id: i.json.id, email: i.json.email, subject: '[' + i.json.level + '] ' + redact(i.json.subject).slice(0, 180), body: redact(i.json.body).slice(0, 3000) + '\\n\\n-- Content Automation System' } }));"
      },
      "id": "17d42467-714e-54ca-9f44-61f1e9a30453",
      "name": "Format And Redact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },

{
  "id": "cawf140000000000",
  "name": "CA 14 Notifications (Gmail)",
  "nodes": [
    {
      "parameters": {
        "content": "Only CRITICAL and IMPORTANT rows are evaluated. Allowlist: auth, system, storage, resource, policy, rights, publish, error. Deduplicated at insert. Bodies are re-redacted here. Gmail failures open the 'gmail' circuit (bounded retries). Explicit Send-Approval Gate strictly blocks unapproved outbound dispatches.",
        "height": 160,
        "width": 700
      },
      "id": "ce6ba607-f197-5465-a583-173f409b82c5",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -360
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "2ec45cc1-58ac-5026-8daa-54fc1ffb43e3",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT n.id, n.level, n.category, n.subject, n.body, (ca_setting('notify_email','\"\"'))#>>'{}' AS email, (ca_setting('email_send_approval','null')) AS approval FROM notifications n WHERE n.status = 'pending' AND n.level IN ('CRITICAL','IMPORTANT') AND n.category IN ('auth','system','storage','resource','policy','rights','publish','error') AND NOT (n.category = 'publish' AND n.subject LIKE 'Published on%') AND ca_circuit_allowed('gmail') ORDER BY (n.level = 'CRITICAL') DESC, n.created_at LIMIT 10 FOR UPDATE SKIP LOCKED",
        "options": {}
      },
      "id": "ab0f2fd2-3903-5942-98ac-fc11b7f02eb4",
      "name": "Claim Pending",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "cacred0000000001",
          "name": "CA Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",

        0,
        540
      ],
      "webhookId": "e46b62f0-ef6a-5790-bcce-e9f79746cba1"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {}; const num = (x, lo, hi) => { const n = Number(x); if (!isFinite(n) || n < lo || n > hi) throw new Error('VALIDATION: out of range'); return n; };\nreturn [{ json: { cpu: num(b.cpu_percent, 0, 100), ram: num(b.ram_percent, 0, 100), disk: num(b.disk_free_gb, 0, 100000) } }];"
      },
      "id": "059a276a-f48d-5c40-b905-6afa8a8c6846",
      "name": "Validate Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        540
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO resource_snapshots(cpu_percent, ram_percent, disk_free_gb) VALUES ($1::numeric, $2::numeric, $3::numeric) RETURNING id",
        "options": {
          "queryReplacement": "={{ [$json.cpu, $json.ram, $json.disk] }}"
        }
      },
      "id": "4003a339-e870-54d4-b100-92649ecd6fc6",
      "name": "Insert Snapshot",

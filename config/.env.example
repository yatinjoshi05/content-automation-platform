# Copy to config/.env and fill in. NEVER commit config/.env. Values here are read by deployment/deploy.js and passed to n8n.
# --- PostgreSQL (application database; n8n's own metadata DB is separate and configured in n8n) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=content_automation
DB_USER=postgres
DB_PASSWORD=
# --- n8n ---
N8N_URL=http://localhost:5678
N8N_CMD=n8n
# Persistent user data folder for n8n executions/workflows (pointing to D: preserves C: space)
N8N_USER_FOLDER=D:\n8n_data
# Header-Auth secret that protects all worker/API webhooks (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
CA_INTERNAL_KEY=
# Shared secret between n8n and OpenShorts webhook signatures (generate like above)
OPENSHORTS_WEBHOOK_SECRET=
# --- OpenShorts / QA worker ---
OPENSHORTS_URL=http://localhost:8000
QA_WORKER_URL=http://localhost:9100
# Scratch working directory for media QA & thumbnails (pointing to D: preserves C: space)
QA_WORK_DIR=D:\qa_work
# --- Notifications (optional) ---
NOTIFY_EMAIL=
# --- Windows/Node tool paths (optional overrides) ---
PSQL_CMD=D:\tools\pgsql\bin\psql.exe
FFMPEG_CMD=D:\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_CMD=D:\tools\ffmpeg\bin\ffprobe.exe

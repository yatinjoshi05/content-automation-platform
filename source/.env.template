# ===== Content Automation System — environment template (copy to .env; NEVER commit real values) =====
# --- n8n (set in the environment that launches n8n) ---
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/            # base URL n8n uses for webhooks (also put in settings.n8n_webhook_base)
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_BLOCK_ENV_ACCESS_IN_NODE=false            # REQUIRED: Code/expression nodes read OPENSHORTS_WEBHOOK_SECRET via $env
NODE_FUNCTION_ALLOW_BUILTIN=crypto            # REQUIRED: webhook HMAC verification uses Node's crypto
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72                    # hours; n8n history is NOT the system of record (PostgreSQL is)
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none          # recommended: keeps the OpenShorts request body (contains the webhook secret) out of history
# --- shared secret between n8n and OpenShorts (generate: openssl rand -hex 32) ---
OPENSHORTS_WEBHOOK_SECRET=
# --- PostgreSQL (create these as an n8n *Postgres* credential; they are NOT read by workflows) ---
CA_DB_HOST=localhost
CA_DB_PORT=5432
CA_DB_NAME=content_automation
CA_DB_USER=ca_app
CA_DB_PASSWORD=
# --- credentials are created inside n8n's Credentials UI, not here (names suggested in SETUP.md) ---
# YouTube Data API key (httpQueryAuth: name=key) · YouTube OAuth2 · Gmail OAuth2 · Header Auth (X-CA-Key) · optional Gemini/Groq/Meta tokens
